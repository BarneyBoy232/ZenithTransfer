# Optional — point the app at your OWN signaling server (keeps everything P2P;
# just makes connecting reliable instead of using the overloaded public cloud).
# Set these in Vercel → Project → Settings → Environment Variables, then redeploy.
# Leave them unset to fall back to the public PeerJS cloud.

# VITE_PEER_HOST=zenithtransfer-signal.onrender.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/rtc
# VITE_PEER_SECURE=true
